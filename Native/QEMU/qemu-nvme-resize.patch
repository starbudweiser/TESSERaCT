+/*
+ * The image of the namespace was made larger or smaller while the guest runs: work out the new size and
+ * tell the controller, which has the guest read the namespace again.
+ */
+static void nvme_ns_resize(void *opaque)
+{
+    NvmeNamespace *ns = opaque;
+    int64_t size = blk_getlength(ns->blkconf.blk);
+
+    if (size < 0 || size == ns->size) {
+        return;
+    }
+
+    ns->size = size;
+    nvme_ns_init_format(ns);
+    nvme_ns_notify_resize(ns);
 }
 
+static const BlockDevOps nvme_ns_blk_ops = {
+    .resize_cb = nvme_ns_resize,
+};
